<div class="content">


  <h1 style="font-size: 28px; color: #111111; margin-top: 0; margin-bottom: 24px; font-weight: 700; letter-spacing: -0.5px;">Order Confirmation 🎉</h1>
  <p style="font-size: 16px; font-weight: 600; color: #222222; margin-bottom: 12px;">Hi {{parent_name}},</p>
  <p style="font-size: 16px; color: #555555; line-height: 1.6; margin-top: 0; margin-bottom: 30px;">Thank you for choosing Infano Care. Your order has been successfully placed and is now being processed. Below are the details of your purchase.</p>

  <table style="width: 100%; margin-top: 30px; border-top: 1px solid #E5E5E5; padding-top: 20px;">
    <tr>
      <td style="width: 50%; vertical-align: top;">
        <p style="margin: 0; color: #666666; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Order Number</p>
        <p style="margin: 5px 0 0 0; font-weight: 600; color: #111111;">#{{order_id}}</p>
      </td>
      <td style="width: 50%; vertical-align: top;">
        <p style="margin: 0; color: #666666; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px;">Order Date</p>
        <p style="margin: 5px 0 0 0; font-weight: 600; color: #111111;">{{order_date}}</p>
      </td>
    </tr>
  </table>

  <h3 style="border-bottom: 1px solid #E5E5E5; padding-bottom: 10px; margin-top: 30px; font-size: 16px; font-weight: 500; color: #111111;">Items Ordered</h3>
  <table style="width: 100%; margin-top: 15px; border-collapse: collapse;">
    {{#each order_items}}
    <tr>
      <td style="padding: 15px 0; border-bottom: 1px solid #F0F0F0; width: 70px;">
        <img src="https://api.infano.care/uploads/assets/Page-1.png" alt="{{this.title}}" style="width: 50px; height: auto; border: 1px solid #E5E5E5;">
      </td>
      <td style="padding: 15px 10px; border-bottom: 1px solid #F0F0F0; vertical-align: middle;">
        <p style="margin: 0; font-weight: 500; color: #111111;">{{this.title}}</p>
        <p style="margin: 4px 0 0 0; font-size: 13px; color: #666666;">Quantity: {{this.quantity}}</p>
      </td>
      <td style="padding: 15px 0; border-bottom: 1px solid #F0F0F0; vertical-align: middle; text-align: right; font-weight: 500; color: #111111;">
        {{this.price}}
      </td>
    </tr>
    {{/each}}
    <tr>
      <td colspan="2" style="padding: 15px 10px; text-align: right; color: #666666;">Subtotal</td>
      <td style="padding: 15px 0; text-align: right; font-weight: 500; color: #111111;">{{subtotal}}</td>
    </tr>
    <tr>
      <td colspan="2" style="padding: 15px 10px; text-align: right; color: #666666;">Discount</td>
      <td style="padding: 15px 0; text-align: right; font-weight: 500; color: #111111;">{{discount}}</td>
    </tr>
    <tr>
      <td colspan="2" style="padding: 15px 10px; text-align: right; color: #111111; font-weight: 600;">Total</td>
      <td style="padding: 15px 0; text-align: right; font-weight: 700; color: #111111; font-size: 16px;">{{total}}</td>
    </tr>
  </table>

  <div class="tracker" style="margin-top: 40px; margin-bottom: 20px;">
    <div class="tracker-cell">
      <div class="tracker-circle current"><img src="https://img.icons8.com/ios-filled/50/ffffff/shopping-bag.png" alt="Ordered"></div>
      <div class="tracker-line"></div>
      <span class="tracker-label current">Ordered</span>
    </div>
    <div class="tracker-cell">
      <div class="tracker-circle"><img src="https://img.icons8.com/ios-filled/50/999999/truck.png" alt="Shipped"></div>
      <div class="tracker-line"></div>
      <span class="tracker-label">Shipped</span>
    </div>
    <div class="tracker-cell">
      <div class="tracker-circle"><img src="https://img.icons8.com/ios-filled/50/999999/box.png" alt="Delivered"></div>
      <span class="tracker-label">Delivered</span>
    </div>
  </div>

  <div style="margin-top: 20px; margin-bottom: 40px; text-align: center;">
    <a href="{{view_order_url}}" class="button">View Order</a>
  </div>

  <table style="width: 100%; margin-top: 30px;">
    <tr>
      <td style="width: 50%; vertical-align: top; padding-right: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 13px; color: #666666; text-transform: uppercase; letter-spacing: 0.5px;">Shipping Address</h4>
        <p style="margin: 0; color: #111111; font-size: 14px; line-height: 1.5;">
          {{shipping_address.name}}<br>
          {{shipping_address.full_address}}
        </p>
      </td>
      <td style="width: 50%; vertical-align: top; padding-left: 15px;">
         <h4 style="margin: 0 0 10px 0; font-size: 13px; color: #666666; text-transform: uppercase; letter-spacing: 0.5px;">Payment Method</h4>
         <p style="margin: 0; color: #111111; font-size: 14px; line-height: 1.5;">
           {{payment_method}}
         </p>
      </td>
    </tr>
  </table>



  <div class="help-section">
    <p style="margin: 0;">Need help? Reply to this email or visit our <a href="https://infano.care/support" style="color: #111111; text-decoration: underline;">Support Center</a>.</p>
  </div>
</div>
