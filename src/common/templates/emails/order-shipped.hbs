<div class="content">


  <h1 style="font-size: 28px; color: #111111; margin-top: 0; margin-bottom: 24px; font-weight: 700; letter-spacing: -0.5px;">Order Shipped 🚀</h1>
  <p style="font-size: 16px; font-weight: 600; color: #222222; margin-bottom: 12px;">Hi {{parent_name}},</p>
  <p style="font-size: 16px; color: #555555; line-height: 1.6; margin-top: 0; margin-bottom: 30px;">Great news! The following items from your order <strong>#{{order_id}}</strong> have been shipped and are on their way to you.</p>

  <h3 style="border-bottom: 1px solid #E5E5E5; padding-bottom: 10px; margin-top: 30px; font-size: 16px; font-weight: 500; color: #111111;">Shipment Details</h3>
  <table style="width: 100%; margin-top: 15px; border-collapse: collapse;">
    {{#each order_items}}
    <tr>
      <td style="padding: 15px 0; border-bottom: 1px solid #F0F0F0; width: 70px;">
        <img src="https://api.infano.care/uploads/assets/Page-1.png" alt="{{this.title}}" style="width: 50px; height: auto; border: 1px solid #E5E5E5;">
      </td>
      <td style="padding: 15px 10px; border-bottom: 1px solid #F0F0F0; vertical-align: middle;">
        <p style="margin: 0; font-weight: 500; color: #111111;">{{this.title}}</p>
        <p style="margin: 4px 0 0 0; font-size: 13px; color: #666666;">Quantity: {{this.quantity}}</p>
      </td>
    </tr>
    {{/each}}
  </table>

  <div class="tracker" style="margin-top: 40px; margin-bottom: 20px;">
    <div class="tracker-cell">
      <div class="tracker-circle completed"><img src="https://img.icons8.com/ios-filled/50/ffffff/checkmark--v1.png" alt="Done"></div>
      <div class="tracker-line completed"></div>
      <span class="tracker-label completed">Ordered</span>
    </div>
    <div class="tracker-cell">
      <div class="tracker-circle current"><img src="https://img.icons8.com/ios-filled/50/ffffff/truck.png" alt="Shipped"></div>
      <div class="tracker-line"></div>
      <span class="tracker-label current">Shipped</span>
    </div>
    <div class="tracker-cell">
      <div class="tracker-circle"><img src="https://img.icons8.com/ios-filled/50/999999/box.png" alt="Delivered"></div>
      <span class="tracker-label">Delivered</span>
    </div>
  </div>

  <div style="margin-top: 20px; margin-bottom: 40px; text-align: center;">
    <a href="{{tracking_url}}" class="button">Track Package</a>
  </div>

  <table style="width: 100%; margin-top: 30px;">
    <tr>
      <td style="width: 50%; vertical-align: top; padding-right: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 13px; color: #666666; text-transform: uppercase; letter-spacing: 0.5px;">Tracking Information</h4>
        <p style="margin: 0; color: #111111; font-size: 14px; line-height: 1.5;">
          Carrier: {{courier_name}}<br>
          Tracking #: <strong>{{tracking_id}}</strong>
        </p>
      </td>
      <td style="width: 50%; vertical-align: top; padding-left: 15px;">
        <h4 style="margin: 0 0 10px 0; font-size: 13px; color: #666666; text-transform: uppercase; letter-spacing: 0.5px;">Shipping Address</h4>
        <p style="margin: 0; color: #111111; font-size: 14px; line-height: 1.5;">
          {{shipping_address.name}}<br>
          {{shipping_address.full_address}}
        </p>
      </td>
    </tr>
  </table>



  <div class="help-section">
    <p style="margin: 0;">Need help? Reply to this email or visit our <a href="https://infano.care/support" style="color: #111111; text-decoration: underline;">Support Center</a>.</p>
  </div>
</div>
