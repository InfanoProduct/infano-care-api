<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Helvetica+Neue:wght@400;500;700&display=swap');
    
    body {
      margin: 0;
      padding: 0;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      background-color: #F5F0F6; /* very slight purple tint */
      color: #333333;
      -webkit-font-smoothing: antialiased;
    }
    table {
      border-spacing: 0;
      border-collapse: collapse;
    }
    .wrapper {
      width: 100%;
      background-color: #F5F0F6;
      padding: 40px 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #FFFFFF;
      border: 1px solid #EAE3EC;
      border-top: 4px solid #9C27B0; /* Purple accent top border */
      border-radius: 8px;
    }
    .header {
      text-align: left;
      padding: 30px 40px;
      border-bottom: 1px solid #F0EBF1;
    }
    .header img {
      height: 45px;
      width: auto;
      display: block;
    }
    .preheader {
      display: none;
      max-height: 0px;
      overflow: hidden;
    }
    .content {
      padding: 40px;
      font-size: 15px;
      line-height: 1.6;
      color: #444444;
    }
    .button {
      display: inline-block;
      padding: 14px 28px;
      background-color: #9C27B0; /* Violet/Purple */
      color: #FFFFFF !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      margin: 20px 0;
      text-align: center;
      transition: background-color 0.2s ease;
      border-radius: 6px;
      box-shadow: 0 4px 6px rgba(156, 39, 176, 0.15);
    }
    .button:hover {
      background-color: #7B1FA2;
    }
    .tracker {
      display: table;
      width: 100%;
      margin: 10px 0 40px;
      table-layout: fixed;
    }
    .tracker-cell {
      display: table-cell;
      text-align: center;
      vertical-align: top;
      position: relative;
    }
    .tracker-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: #F0EBF1;
      color: #999999;
      display: inline-block;
      line-height: 36px;
      font-size: 14px;
      font-weight: 700;
      position: relative;
      z-index: 2;
    }
    .tracker-circle img {
      width: 18px;
      height: 18px;
      display: block;
      margin: 9px auto 0;
    }
    .tracker-circle.completed {
      background-color: #9C27B0; /* Purple */
      color: #FFFFFF;
    }
    .tracker-circle.current {
      background-color: #D81B60; /* Pinkish */
      color: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(216, 27, 96, 0.15);
    }
    .tracker-line {
      position: absolute;
      top: 17px;
      left: 50%;
      width: 100%;
      height: 3px;
      background-color: #F0EBF1;
      z-index: 1;
    }
    .tracker-line.completed {
      background-color: #9C27B0;
    }
    .tracker-label {
      font-size: 13px;
      color: #888888;
      margin-top: 12px;
      display: block;
      font-weight: 500;
    }
    .tracker-label.completed {
      color: #9C27B0;
      font-weight: 600;
    }
    .tracker-label.current {
      color: #D81B60;
      font-weight: 600;
    }
    .footer {
      text-align: left;
      padding: 30px 40px;
      font-size: 13px;
      color: #888888;
      background-color: #FAFAFA;
      border-top: 1px solid #EAE3EC;
      line-height: 1.6;
      border-radius: 0 0 8px 8px;
    }
    .footer a {
      color: #9C27B0;
      text-decoration: underline;
    }
    .help-section {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px dashed #EAE3EC;
      font-size: 14px;
      color: #666666;
    }
    @media only screen and (max-width: 600px) {
      .container {
        width: 100% !important;
        border-radius: 0 !important;
        border-left: 0 !important;
        border-right: 0 !important;
      }
      .header, .content, .footer {
        padding: 20px !important;
      }
      .mobile-block {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .mobile-pt-15 {
        padding-top: 15px !important;
      }
      .mobile-pl-0 {
        padding-left: 0 !important;
      }
      .mobile-pr-0 {
        padding-right: 0 !important;
      }
      .tracker-label {
        font-size: 11px !important;
      }
      .tracker-circle {
        width: 30px !important;
        height: 30px !important;
        line-height: 30px !important;
      }
      .tracker-circle img {
        width: 15px !important;
        height: 15px !important;
        margin: 7px auto 0 !important;
      }
      .tracker-line {
        top: 14px !important;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <img src="https://api.infano.care/uploads/assets/infano-logo-for-light-bg.png" alt="Infano Care Logo">
      </div>
      <div class="preheader">
        {{preheaderText}}
      </div>
      
      {{{body}}}
      
      <div class="footer">
        <img src="https://api.infano.care/uploads/assets/infano-logo-for-light-bg.png" alt="Infano Care Logo" style="height: 28px; margin-bottom: 15px; opacity: 0.8;">
        <p style="margin: 0 0 10px 0;"><strong>Infano.Care</strong></p>
        <p style="margin: 0 0 20px 0;">Empowering adolescent girls, one family at a time.</p>
        <p style="margin: 0;">
          <a href="https://infano.care/about">About Us</a> &nbsp;|&nbsp; 
          <a href="https://infano.care/contact">Contact</a> &nbsp;|&nbsp; 
          <a href="https://infano.care/privacy">Privacy Policy</a>
        </p>
        <p style="margin: 20px 0 0 0;">&copy; 2026 Infano Care. All rights reserved.</p>
      </div>
    </div>
  </div>
</body>
</html>
