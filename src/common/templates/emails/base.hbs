<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;850&display=swap');
    
    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background-color: #F8F6FC; /* Extremely soft lavender-tinted background */
      color: #374151; /* Tailored charcoal color for better readability */
      -webkit-font-smoothing: antialiased;
    }
    table {
      border-spacing: 0;
      border-collapse: collapse;
    }
    .wrapper {
      width: 100%;
      background-color: #F8F6FC;
      padding: 40px 0;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #FFFFFF;
      border: 1px solid #EAE3EC;
      border-radius: 16px; /* Smooth rounded corners */
      box-shadow: 0 10px 25px -5px rgba(156, 39, 176, 0.05), 0 8px 10px -6px rgba(156, 39, 176, 0.03);
      overflow: hidden;
    }
    /* Brand Gradient Accent Line */
    .brand-accent {
      height: 6px;
      background: linear-gradient(90deg, #9C27B0 0%, #E91E63 50%, #FF2E93 100%);
      width: 100%;
    }
    .header {
      text-align: center; /* Centered logo for a balanced, premium feel */
      padding: 35px 40px 25px;
      background-color: #FFFFFF;
    }
    .header img {
      height: 40px;
      width: auto;
      display: inline-block;
    }
    .preheader {
      display: none;
      max-height: 0px;
      overflow: hidden;
    }
    .content {
      padding: 0 40px 40px;
      font-size: 15px;
      line-height: 1.6;
      color: #4B5563;
    }
    .button {
      display: inline-block;
      padding: 14px 30px;
      background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%); /* Interactive gradient purple */
      color: #FFFFFF !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 15px;
      text-align: center;
      border-radius: 9999px; /* Pill-shaped button for modern app styling */
      box-shadow: 0 4px 10px rgba(156, 39, 176, 0.25);
      transition: all 0.2s ease;
    }
    .button:hover {
      box-shadow: 0 6px 15px rgba(156, 39, 176, 0.35);
    }
    .tracker {
      display: block;
      width: 100%;
      margin: 20px 0 35px;
      font-size: 0;
      text-align: center;
    }
    .tracker-cell {
      display: inline-block;
      width: 33.33%;
      text-align: center;
      vertical-align: top;
      position: relative;
      box-sizing: border-box;
    }
    .tracker-circle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background-color: #F3E8FF; /* Very soft violet background */
      color: #A855F7;
      display: inline-block;
      vertical-align: top;
      line-height: 40px;
      position: relative;
      z-index: 2;
      border: 2px solid #FFFFFF;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    }
    .tracker-circle img {
      width: 18px;
      height: 18px;
      display: block;
      margin: 11px auto 0;
    }
    .tracker-circle.completed {
      background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
      color: #FFFFFF;
      box-shadow: 0 2px 8px rgba(156, 39, 176, 0.2);
    }
    .tracker-circle.current {
      background: linear-gradient(135deg, #E91E63 0%, #D81B60 100%); /* Rose-pink highlight for active state */
      color: #FFFFFF;
      box-shadow: 0 0 0 4px rgba(233, 30, 99, 0.2);
    }
    .tracker-line {
      height: 3px;
      background-color: #E9D5FF;
      border-radius: 2px;
      line-height: 3px;
      font-size: 0;
      display: block;
    }
    .tracker-line.completed {
      background: linear-gradient(90deg, #9C27B0 0%, #E91E63 100%);
    }
    .tracker-label {
      font-size: 13px;
      color: #6B7280;
      margin-top: 10px;
      display: block;
      font-weight: 500;
    }
    .tracker-label.completed {
      color: #7B1FA2;
      font-weight: 600;
    }
    .tracker-label.current {
      color: #E91E63;
      font-weight: 600;
    }
    .footer {
      text-align: center; /* Centered footer for standard layout balance */
      padding: 35px 40px;
      font-size: 13px;
      color: #6B7280;
      background-color: #FAF9FB;
      border-top: 1px solid #F3E8FF;
      line-height: 1.6;
    }
    .footer a {
      color: #9C27B0;
      text-decoration: none;
      font-weight: 500;
    }
    .footer a:hover {
      text-decoration: underline;
    }
    .help-section {
      margin-top: 35px;
      padding-top: 20px;
      border-top: 1px dashed #E5E7EB;
      font-size: 14px;
      color: #6B7280;
      text-align: center;
    }
    .help-section a {
      color: #9C27B0;
      text-decoration: none;
      font-weight: 600;
    }
    .help-section a:hover {
      text-decoration: underline;
    }
    @media only screen and (max-width: 600px) {
      .container {
        width: 100% !important;
        border-radius: 0 !important;
        border-left: 0 !important;
        border-right: 0 !important;
      }
      .header {
        padding: 25px 20px 15px !important;
      }
      .content, .footer {
        padding: 20px !important;
      }
      .mobile-block {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
      }
      .mobile-pt-15 {
        padding-top: 15px !important;
      }
      .mobile-pl-0 {
        padding-left: 0 !important;
      }
      .mobile-pr-0 {
        padding-right: 0 !important;
      }
      .tracker-label {
        font-size: 11px !important;
      }
      .tracker-circle {
        width: 32px !important;
        height: 32px !important;
        line-height: 32px !important;
      }
      .tracker-circle img {
        width: 14px !important;
        height: 14px !important;
        margin: 9px auto 0 !important;
      }
      /* no mobile overrides needed for table-based line */
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="brand-accent"></div>
      <div class="header">
        <img src="https://api.infano.care/uploads/assets/infano-logo-for-light-bg.png" alt="Infano Care Logo" width="160" height="40" border="0" style="display: inline-block; width: 160px; max-width: 160px; height: 40px; border: 0; outline: none; text-decoration: none;">
      </div>
      <div class="preheader">
        {{preheaderText}}
      </div>
      
      {{{body}}}
      
      <div class="footer">
        <img src="https://api.infano.care/uploads/assets/infano-logo-for-light-bg.png" alt="Infano Care Logo" width="96" height="24" border="0" style="height: 24px; width: 96px; margin-bottom: 12px; opacity: 0.6; display: inline-block; border: 0; outline: none;">
        <p style="margin: 0 0 6px 0; font-weight: 600; color: #4B5563;">Infano.Care</p>
        <p style="margin: 0 0 15px 0; font-size: 12px; color: #9CA3AF;">Empowering adolescent girls, one family at a time.</p>
        <p style="margin: 0; font-size: 12px;">
          <a href="https://infano.care/about">About Us</a> &nbsp;&bull;&nbsp; 
          <a href="https://infano.care/contact">Contact</a> &nbsp;&bull;&nbsp; 
          <a href="https://infano.care/legal#privacy">Privacy Policy</a>
        </p>
        <p style="margin: 15px 0 0 0; font-size: 11px; color: #9CA3AF;">&copy; 2026 Infano Care. All rights reserved.</p>
      </div>
    </div>
  </div>
</body>
</html>
